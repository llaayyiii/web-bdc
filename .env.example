# ==============================================================================
# Business Dev Club (BDC) - Environment Configuration
# Salin file ini menjadi .env.local untuk pengembangan lokal
# ==============================================================================

# Supabase Free Tier Configuration (Dapat diperoleh dari Project Settings > API di supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Khusus Server Actions yang memerlukan bypass RLS untuk Admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Konfigurasi Domain Kampus Resmi
NEXT_PUBLIC_CAMPUS_DOMAIN=students.utdi.ac.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000
